# -------------------------------------------------------------------------
# msp-mcs
# -------------------------------------------------------------------------
MCS_PUB_DEVICES_16bit=D,6364,1,D,6464,1,D,6564,1,D,1021,4,D,1022,4,D,1023,4,D,1016,1,D,1017,1,D,1018,1,D,26,1,D,27,1,D,28,1
MCS_PUB_DEVICES_2bit=M,3930,3
MCS_PUB_DEVICES_32bit=
MCS_PUB_DEVICES_ASCII=D,1010,4,D,1011,4,D,1012,4,D,1013,4,D,1014,4,D,1015,4,D,1020,4,D,1021,4,D,1022,4,D,1023,4
MCS_PUB_MQTT_TOPIC=holding_register/all/
MCS_PUB_MQTTS_ON=false
MCS_PUB_PLC_HOST=192.168.3.114
MCS_PUB_PLC_MODEL=
MCS_PUB_PLC_PORT=5013
MCS_PUB_PPROFT_PORT=6061

# -------------------------------------------------------------------------
# gopub-edge-mcs
# -------------------------------------------------------------------------
MCS_MQTT_TOPIC="holding_register/all/+"
MCS_MQTTS_ON=false
MCS_MQTT_PORT=1883
MCS_INSERT_MODE=
MCS_TRIGGER_DEVICE=y8c,weightmcs
MCS_LOOPING=0.5
MCS_FILTER=d174
MCS_CYCLE_ANCHOR_TOPIC=d1010
MCS_CYCLE_MODE_ENABLED=true
MCS_CYCLE_TIMEOUT_SEC=6

# -------------------------------------------------------------------------
# gopub-edge-healthcheck
# -------------------------------------------------------------------------
HEALTHCHECK_MQTT_TOPIC="holding_register/all/+"
HEALTHCHECK_MQTTS_ON=false
HEALTHCHECK_MQTT_PORT=1883
HEALTHCHECK_LOCAL_VACUUM_REQUEST_TOPIC="gopub-edge/vacuum/request"
HEALTHCHECK_MQTT_REPLY_TOPIC_PREFIX="gopub-edge/reply/"
HEALTHCHECK_MQTT_REPLY_TIMEOUT_SEC=10
HEALTHCHECK_INSERT_MODE=upsert
HEALTHCHECK_TRIGGER_DEVICE=m1160,vacuum
HEALTHCHECK_LOOPING=0.5
HEALTHCHECK_FILTER=d174
HEALTHCHECK_CYCLE_ANCHOR_TOPIC=d1010
HEALTHCHECK_CYCLE_MODE_ENABLED=true
HEALTHCHECK_CYCLE_TIMEOUT_SEC=6
HEALTHCHECK_PLC_HOST=192.168.3.111
HEALTHCHECK_PLC_PORT=5013

# -------------------------------------------------------------------------
# govacuum-engine-healthcheck
# -------------------------------------------------------------------------
# analytics.metrics lives outside the default "public" schema. Two things
# both need to be true or every request 404s/400s:
#   1. This must say "analytics" (matches the schema in your table DDL)
#   2. "analytics" must be added to Supabase's exposed-schemas list:
#      Project Settings → API → Exposed schemas
GO_VACUUM_ENGINE_SUPABASE_SCHEMA=analytics
# How many historical rows (per device_id) to pull for the IQR calculation.
GO_VACUUM_ENGINE_IQR_HISTORY_LIMIT=1000
GO_VACUUM_ENGINE_EMQX_CLIENT_ID_PREFIX=vacuum-engine_
GO_VACUUM_ENGINE_MOSQUITTO_CLIENT_ID_PREFIX=vacuum-engine-reply_
GO_VACUUM_ENGINE_LOCAL_VACUUM_REQUEST_TOPIC="gopub-edge/vacuum/request"
GO_VACUUM_ENGINE_MQTTS_ON=false
GO_VACUUM_ENGINE_MQTT_PORT=1883

# -------------------------------------------------------------------------
# KEY TRANSFORMATION
# -------------------------------------------------------------------------
# Trigger Device format
# trigger + case option = trigger1,option1,tigger2.option2,
# Case option.
# 1. "time.duration" ; Calculate the start time and end time of the trigger and replace time duration as a payload.
# 2. "standard" ; Patch data to database if trigger is true 
# 3. "trigger" ; Fetch data for LOOPING secs and Patch data once trigger is true
# 4. "hold" ; Fetch the data and store it to diff map, combine into a single data and patch it.
# 5. "special"
# 6. "holdfilling"
# 7. "weight"
# 8. "holdfillingweight"
########
# hold example usage : 
# HOLD_KEY_TRANSOFRMATION_title1=device
# HOLD_KEY_TRANSOFRMATION_title2=device...

