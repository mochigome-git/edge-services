PUB_DEVICES_2bit=M,1540,3,Y,54A,3,Y,54E,3,Y,562,3,M,1460,3,Y,54D,3,Y,561,3,Y,565,3,M,1160,3
PUB_MQTT_TOPIC=holding_register/all/
PUB_DEVICES_16bit=D,601,1,D,2870,1,D,706,1,D,2820,5,D,2810,1,D,736,1,D,2616,1,D,2630,1,D,840,1,D,2800,5,D,2826,5,D,2634,1,D,2866,1,D,243,1,D,244,1,D,248,1,D,2904,1,D,2905,1,D,2906,1,D,2903,1
PUB_MQTTS_ON=false
PUB_PLC_HOST=192.168.3.111
