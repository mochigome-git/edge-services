# -------------------------------------------------------------------------
# Basic Info 
# -------------------------------------------------------------------------
TENANT_ID=uuid
EMQX_CLIENT_ID_PREFIX=device-name

# -------------------------------------------------------------------------
# Database 
# -------------------------------------------------------------------------
# Supabase, via the REST API (PostgREST), not a direct
# Postgres connection. No connection pool, no DB password needed.

# service_role key specifically — NOT anon. This engine needs to bypass
# RLS for both the historical read and the insert. Find it in the
# Supabase dashboard: Project Settings → API → Project API keys.
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxx"


# -------------------------------------------------------------------------
# MQTT (Subscriber — Mosquitto, receives raw PLC data)
# -------------------------------------------------------------------------

MQTT_HOST=mqtt://mosquitto:1883
MQTT_HOST_CLEAR_DNS=mosquitto



# -------------------------------------------------------------------------
# MQTT (Publisher — EMQX, sends insert/upsert requests downstream)
# This is a DIFFERENT broker from the subscriber above. gopub-edge
# publishes patch/upsert requests here instead of calling Supabase
# directly; gokafka-raw (or your reply engine) consumes them, does the
# insert, and — for upsert only — replies on EMQX_REPLY_TOPIC_PREFIX+<id>.
# -------------------------------------------------------------------------

EMQX_HOST=xxx.emqxsl.com
EMQX_PORT=8883
EMQX_USERNAME=secret
EMQX_PASSWORD=secret
EMQX_TLS_ON=
MQTT_DEBUG=false

# Optional. Leave blank if EMQX_HOST's certificate is already trusted by
# the system, or if you're only using username/password auth (no mTLS).
EMQX_CA_CERTIFICATE="-----BEGIN CERTIFICATE-----
KEY
-----END CERTIFICATE-----
"
EMQX_CLIENT_CERTIFICATE=""
EMQX_PRIVATE_KEY=""

# Topic gopub-edge publishes patch/upsert requests to.
EMQX_INSERT_REQUEST_TOPIC="demo/devices/payload"

